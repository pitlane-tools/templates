{
    "nodeModulesDir": "auto",
    "imports": {
        "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.4",
        "@electric-sql/pglite-socket": "npm:@electric-sql/pglite-socket@^0.2.7",
        "@pitlane/dev": "npm:@pitlane/dev@^0.4.0",
        "pg": "npm:pg@^8.22.0",
        "remix": "npm:remix@3.0.0-rc.1",
        "vite": "npm:vite@^8.1.5",
    },
    "tasks": {
        "dev": "mkdir -p .data && deno run -A npm:@electric-sql/pglite-socket@^0.2.7/pglite-server --db=./.data/postgres --port=54329 --max-connections=10 --include-database-url --run 'deno task dev:ready'",
        "dev:ephemeral": "deno run -A npm:@electric-sql/pglite-socket@^0.2.7/pglite-server --db=memory:// --port=54329 --max-connections=10 --include-database-url --run 'deno task dev:ready'",
        "dev:ready": "deno task db:migrate && deno run -A npm:vite@^8.1.5 dev --host",
        "build": "deno run -A npm:vite@^8.1.5 build",
        "preview": "deno run -A npm:vite@^8.1.5 preview",
        "check": "deno task build && deno check db/migrate.ts main.ts",
        "fmt": "deno run -A npm:oxfmt@^0.47.0",
        "lint": "deno run -A npm:oxlint@^1.62.0",
        // Lint and type-check tooling, plus the ambient type packages the
        // type-aware pass reads. `deno cache` materialises them into
        // node_modules and records them in deno.lock without adding anything
        // to `imports`, so none of it is importable from application code.
        // The committed lockfile is what makes `deno install` restore them on
        // a fresh clone; re-run this task when bumping any of these.
        "tooling": "deno cache npm:oxlint-tsgolint npm:@types/node npm:@types/pg npm:@types/deno npm:eslint-plugin-perfectionist",
        "db:migrate": "deno -A db/migrate.ts",
        "db:reset": "rm -rf .data/postgres",
        "start": "deno run -A main.ts",
    },
    "deploy": {
        // `deno deploy` uploads respect .gitignore. Un-exclude the CI-built
        // output so the deploy tarball ships `dist/` — the Vite build always
        // runs in CI (or locally), never on Deno Deploy.
        "exclude": ["!dist"],
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "remix/ui",
    },
    // oxfmt formats this template (`deno task fmt`), the same as every other
    // template here. `deno fmt` is switched off rather than left to fight it:
    // it has no arrow-parens option, so it rewrites files that are currently
    // byte-identical to their node counterparts, and it reindents the SVG
    // logos under public/, which are assets rather than source.
    "fmt": {
        "exclude": ["."],
    },
}
