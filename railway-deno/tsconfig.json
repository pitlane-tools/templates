{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "remix/ui",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["vite/client", "@pitlane/dev/assets", "node"]
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist"]
}
